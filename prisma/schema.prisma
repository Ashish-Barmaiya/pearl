datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
  TOOL
}

enum ReportStatus {
  PENDING
  COMPLETED
  FAILED
}

model User {
  id    String  @id @default(cuid())
  email String  @unique
  name  String?
  image String?

  /// JSON object storing encrypted provider keys.
  /// Example:
  /// {
  ///   "openai": "...",
  ///   "anthropic": "...",
  ///   "kimi": "..."
  /// }
  providerKeys Json?

  credits Int @default(5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats         Chat[]
  reports       Report[]
  usages        Usage[]
  creditHistory CreditTransaction[]
}

model Chat {
  id String @id @default(cuid())

  title String @default("New Chat")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  reports  Report[]

  @@index([userId])
}

model Message {
  id String @id @default(cuid())

  role MessageRole

  content String @db.Text

  model String?

  inputTokens  Int @default(0)
  outputTokens Int @default(0)

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([chatId])
}

model Report {
  id String @id @default(cuid())

  title String

  status ReportStatus @default(PENDING)

  pdfUrl String?

  chatId String
  chat   Chat   @relation(fields: [chatId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([chatId])
}

model Usage {
  id String @id @default(cuid())

  provider String
  model    String

  inputTokens  Int
  outputTokens Int

  estimatedCost Float

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}

model CreditTransaction {
  id String @id @default(cuid())

  amount Int

  reason String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
}
